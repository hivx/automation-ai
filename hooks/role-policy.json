{
  "_note": "Per-role limits (ADJ-02). Enforced by scripts/role-policy.sh. 'write': globs of writable paths ('*' = anywhere; protect.sh still blocks forbidden areas). 'bash': 'any' | 'read-only' | {'allow': [command globs, 'cmd.*' = the profile's cmd.* slots]}; read-only commands are always allowed. 'agents': subagent_type values the role may call. 'stage_exceptions': extra allowances while .team/current.json has the matching stage. 'readonly_scripts': kit scripts (matched by their real path under <kit>/scripts/, K-40) → write-target glob ('' = writes nothing but temp files); a writing script runs only when the role may write its target. 'worktree_write': true = the role may write any file inside its own worktree .claude/worktrees/<n>/ (researcher POC), never the main tree. '_temp': default limits for temp agents (.claude/agents/<name>.md with the `team: temp` marker) — may write (protect.sh still blocks forbidden areas), Bash read-only + basic git + cmd.*, may call only Explore. 'cp-from-kit-templates': cp is allowed only when every source lies under <kit>/templates/ (K-26).",
  "readonly_commands": [
    "cat",
    "ls",
    "head",
    "tail",
    "wc",
    "grep",
    "rg",
    "find",
    "jq",
    "sort",
    "uniq",
    "cut",
    "tr",
    "echo",
    "printf",
    "date",
    "pwd",
    "tree",
    "stat",
    "file",
    "diff",
    "basename",
    "dirname",
    "realpath",
    "which",
    "test",
    "true",
    "sha256sum",
    "sed",
    "paste",
    "ps",
    "pgrep",
    "md5sum",
    "sha1sum",
    "nl",
    "column",
    "seq",
    "cd"
  ],
  "readonly_scripts": {
    "team.py": {
      "write": "docs/team/metrics/scorecard.json",
      "when": [
        "scorecard"
      ]
    },
    "measure.py": "",
    "teamlib.py": "",
    "check-profile.py": "",
    "check-claude-md.py": "",
    "detect-stack.sh": "",
    "explore-cache.sh": "",
    "check-structure.sh": "",
    "validate.sh": "",
    "log-run.sh": "docs/team/metrics/**"
  },
  "roles": {
    "team:team-leader": {
      "write": [
        "docs/team/**",
        ".team/**",
        ".claude/skills/**",
        ".claude/agents/**"
      ],
      "bash": "read-only",
      "agents": [
        "team:*",
        "Explore"
      ],
      "stage_exceptions": {
        "onboard": {
          "write": [
            "CLAUDE.md",
            ".gitignore",
            ".claude/rules/**",
            ".github/**",
            ".gitlab-ci.yml"
          ],
          "bash": {
            "allow": [
              "cp-from-kit-templates",
              "jq *",
              "mkdir *",
              "git status*",
              "cmd.*",
              "python3 *render.py*"
            ]
          }
        }
      }
    },
    "team:tech-lead": {
      "write": [
        "docs/team/**",
        ".team/current.json",
        ".team/session/**"
      ],
      "bash": {
        "allow": [
          "git *",
          "gh pr *",
          "touch .team/active-build",
          "rm .team/active-build",
          "rm -f .team/active-build",
          "touch .team/active-build-*",
          "rm .team/active-build-*",
          "rm -f .team/active-build-*",
          "cmd.*"
        ]
      },
      "agents": [
        "team:dev",
        "team:reviewer",
        "Explore"
      ]
    },
    "team:coach": {
      "write": [
        "docs/team/retro/**",
        "docs/team/proposals/**",
        "docs/team/kit-issues.md",
        "docs/team/metrics/scorecard.json",
        ".team/current.json",
        ".claude/agent-memory/**"
      ],
      "bash": "read-only",
      "agents": []
    },
    "team:analyst": {
      "write": [
        "docs/team/**",
        ".team/current.json",
        ".team/session/**"
      ],
      "bash": "read-only",
      "agents": [
        "Explore"
      ]
    },
    "team:researcher": {
      "write": [
        "docs/team/**",
        ".team/current.json",
        ".team/session/**"
      ],
      "bash": {
        "allow": [
          "git worktree *",
          "cmd.*"
        ]
      },
      "agents": [
        "Explore"
      ],
      "worktree_write": true
    },
    "team:architect": {
      "write": [
        "docs/team/**",
        ".team/current.json",
        ".team/session/**"
      ],
      "bash": "read-only",
      "agents": [
        "Explore"
      ]
    },
    "team:designer": {
      "write": [
        "docs/team/**",
        ".team/current.json",
        ".team/session/**"
      ],
      "bash": "read-only",
      "agents": [
        "Explore"
      ]
    },
    "team:reviewer": {
      "write": [
        ".claude/agent-memory/**"
      ],
      "bash": "read-only",
      "agents": []
    },
    "team:qa": {
      "write": [
        "docs/team/features/**",
        ".team/current.json",
        ".claude/agent-memory/**"
      ],
      "bash": "any",
      "agents": []
    },
    "team:writer": {
      "write": [
        "docs/**",
        "CHANGELOG.md",
        "README.md",
        "CLAUDE.md",
        ".team/current.json"
      ],
      "bash": "read-only",
      "agents": []
    },
    "team:dev": {
      "write": [
        "*"
      ],
      "bash": "any",
      "agents": []
    },
    "team:maintainer": {
      "write": [
        "*"
      ],
      "bash": "any",
      "agents": []
    },
    "team:devops": {
      "write": [
        "*"
      ],
      "bash": "any",
      "agents": []
    },
    "_temp": {
      "write": [
        "*"
      ],
      "bash": {
        "allow": [
          "git status*",
          "git diff*",
          "git log*",
          "git add *",
          "git commit *",
          "cmd.*"
        ]
      },
      "agents": [
        "Explore"
      ]
    }
  }
}
