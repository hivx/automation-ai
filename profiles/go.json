{
  "stack": "go",
  "language": [
    "go"
  ],
  "cmd": {
    "install": "go mod download",
    "build": "go build ./...",
    "test": "go test ./...",
    "test_one": "go test ./$(dirname {file})",
    "lint": "golangci-lint run",
    "typecheck": "go vet ./...",
    "format": "gofmt -w {file}",
    "run": "go run .",
    "migrate": ""
  },
  "formatters_by_ext": {
    ".go": "gofmt -w {file}"
  },
  "structure": {
    "src": ".",
    "tests": "colocated",
    "docs": "docs",
    "scripts": "scripts",
    "config": [
      "go.mod"
    ],
    "allowed_new_file_roots": [
      "cmd",
      "internal",
      "pkg",
      "docs",
      "scripts"
    ]
  },
  "naming": {
    "file": "snake_case",
    "class": "MixedCaps (PascalCase khi export)",
    "function": "MixedCaps (camelCase when not exported)",
    "constant": "MixedCaps",
    "test_file": "{name}_test.go",
    "branch": "team/{id}-{slug}"
  },
  "test": {
    "skip_markers": [
      "t.Skip(",
      "t.SkipNow(",
      "t.Skipf("
    ]
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "secrets/**",
    "go.sum",
    "vendor/**",
    "bin/**",
    "config/production*"
  ],
  "ci": {
    "provider": "github",
    "runner": "ubuntu-latest",
    "setup": [
      "go mod download"
    ]
  },
  "deploy": {
    "staging": "",
    "smoke": "",
    "prod_requires_reviewer": true
  },
  "ui": false,
  "tracker": "github",
  "plugins": {
    "required": [],
    "recommended": [
      "gopls-lsp@claude-plugins-official",
      "security-guidance@claude-plugins-official",
      "github@claude-plugins-official"
    ]
  },
  "notes": {
    "deploy.staging": "Left empty: each project declares it at onboard.",
    "deploy.smoke": "Left empty: each project declares it at onboard.",
    "cmd.test_one": "Go runs tests per package: the command takes the folder of {file}.",
    "cmd.lint": "Requires golangci-lint; if it is missing, use go vet ./....",
    "cmd.run": "Uncertain: for a multi-binary app it is go run ./cmd/<name>.",
    "cmd.migrate": "Left empty: depends on the tool (golang-migrate, goose...)."
  }
}
