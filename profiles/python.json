{
  "stack": "python",
  "language": [
    "python"
  ],
  "cmd": {
    "install": "pip install -e '.[dev]'",
    "build": "python -m build",
    "test": "pytest -q",
    "test_one": "pytest -q {file}",
    "lint": "ruff check .",
    "typecheck": "mypy .",
    "format": "ruff format {file}",
    "run": "python -m app",
    "migrate": "alembic upgrade head"
  },
  "formatters_by_ext": {
    ".py": "ruff format {file}",
    ".pyi": "ruff format {file}"
  },
  "structure": {
    "src": "src",
    "tests": "tests",
    "docs": "docs",
    "scripts": "scripts",
    "config": [
      "pyproject.toml",
      "setup.cfg"
    ],
    "allowed_new_file_roots": [
      "src",
      "tests",
      "docs",
      "scripts"
    ]
  },
  "naming": {
    "file": "snake_case",
    "class": "PascalCase",
    "function": "snake_case",
    "constant": "UPPER_SNAKE_CASE",
    "test_file": "test_{name}.py",
    "branch": "team/{id}-{slug}"
  },
  "test": {
    "skip_markers": [
      "@pytest.mark.skip",
      "@pytest.mark.skipif",
      "@pytest.mark.xfail",
      "pytest.skip(",
      "@unittest.skip"
    ]
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "secrets/**",
    "poetry.lock",
    "uv.lock",
    "Pipfile.lock",
    ".venv/**",
    "vendor/**",
    "config/production*",
    "**/settings/prod*.py"
  ],
  "ci": {
    "provider": "github",
    "runner": "ubuntu-latest",
    "setup": [
      "python -m pip install --upgrade pip",
      "pip install -e '.[dev]'"
    ]
  },
  "deploy": {
    "staging": "",
    "smoke": "",
    "prod_requires_reviewer": true
  },
  "ui": false,
  "tracker": "github",
  "plugins": {
    "required": [],
    "recommended": [
      "pyright-lsp@claude-plugins-official",
      "security-guidance@claude-plugins-official",
      "github@claude-plugins-official"
    ]
  },
  "notes": {
    "deploy.staging": "Left empty: each project declares it at onboard.",
    "deploy.smoke": "Left empty: each project declares it at onboard.",
    "cmd.install": "Assumes pyproject has a [dev] extra; adjust if the project uses requirements.txt/poetry/uv.",
    "cmd.typecheck": "Uncertain: mypy or pyright depending on the project.",
    "cmd.run": "Uncertain: the module name 'app' is an assumption.",
    "cmd.migrate": "Uncertain: only correct when the project uses Alembic; Django uses manage.py migrate."
  }
}
