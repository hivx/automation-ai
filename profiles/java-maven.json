{
  "stack": "java-maven",
  "language": [
    "java"
  ],
  "cmd": {
    "install": "mvn -B -q dependency:go-offline",
    "build": "mvn -B -q package -DskipTests",
    "test": "mvn -B test",
    "test_one": "mvn -B test -Dtest=$(basename {file} .java)",
    "lint": "mvn -B checkstyle:check",
    "typecheck": "mvn -B -q compile",
    "format": "",
    "run": "mvn -B spring-boot:run",
    "migrate": "mvn -B flyway:migrate"
  },
  "formatters_by_ext": {},
  "structure": {
    "src": "src/main/java",
    "tests": "src/test/java",
    "docs": "docs",
    "scripts": "scripts",
    "config": [
      "pom.xml",
      "src/main/resources"
    ],
    "allowed_new_file_roots": [
      "src/main/java",
      "src/main/resources",
      "src/test/java",
      "src/test/resources",
      "docs"
    ]
  },
  "naming": {
    "file": "PascalCase (same as the class name)",
    "class": "PascalCase",
    "function": "camelCase",
    "constant": "UPPER_SNAKE_CASE",
    "test_file": "{Name}Test.java",
    "branch": "team/{id}-{slug}"
  },
  "test": {
    "skip_markers": [
      "@Disabled",
      "@Ignore",
      "Assumptions.assume",
      "assumeTrue("
    ]
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "secrets/**",
    "**/*.jks",
    "**/*.p12",
    "**/*.keystore",
    "target/**",
    "src/main/resources/application-prod*"
  ],
  "ci": {
    "provider": "github",
    "runner": "ubuntu-latest",
    "setup": [
      "mvn -B -q dependency:go-offline"
    ]
  },
  "deploy": {
    "staging": "",
    "smoke": "",
    "prod_requires_reviewer": true
  },
  "ui": false,
  "tracker": "github",
  "plugins": {
    "required": [],
    "recommended": [
      "jdtls-lsp@claude-plugins-official",
      "security-guidance@claude-plugins-official",
      "github@claude-plugins-official"
    ]
  },
  "notes": {
    "deploy.staging": "Left empty: each project declares it at onboard.",
    "deploy.smoke": "Left empty: each project declares it at onboard.",
    "cmd.typecheck": "Compilation is the type-check step for Java.",
    "cmd.lint": "Uncertain: needs maven-checkstyle-plugin in pom.xml.",
    "cmd.format": "Left empty: Maven has no default single-file formatter; declare it if the project uses Spotless.",
    "cmd.run": "Uncertain: only correct for Spring Boot.",
    "cmd.migrate": "Uncertain: only correct with Flyway; Liquibase uses liquibase:update.",
    "protected_paths": "Maven has no lockfile; pom.xml stays editable but the reviewer checks it (STD-DEP-1)."
  }
}
