{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automation-ai/schemas/config.schema.json",
  "title": "team config (.team/config.json)",
  "type": "object",
  "required": [
    "gates",
    "default_size",
    "default_mode",
    "base_branch",
    "protected_branches",
    "limits"
  ],
  "properties": {
    "gates": {
      "type": "object",
      "properties": {
        "G0_takeover": {
          "type": "boolean"
        },
        "G1_spec": {
          "type": "boolean"
        },
        "G2_arch": {
          "type": "boolean"
        },
        "G2b_design": {
          "type": "boolean"
        },
        "G3_plan": {
          "type": "boolean"
        },
        "G4_uat": {
          "type": "boolean"
        },
        "G5_prod": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "Prod always needs a human"
        }
      },
      "additionalProperties": false,
      "required": [
        "G0_takeover",
        "G1_spec",
        "G2_arch",
        "G2b_design",
        "G3_plan",
        "G4_uat",
        "G5_prod"
      ]
    },
    "default_size": {
      "type": "string",
      "enum": [
        "auto",
        "S",
        "M",
        "L"
      ]
    },
    "default_mode": {
      "type": "string",
      "enum": [
        "ask",
        "decide"
      ]
    },
    "output_language": {
      "type": "string",
      "enum": [
        "vi",
        "en"
      ],
      "default": "vi",
      "description": "Language of artifact prose the team writes (vi or en). Machine-read anchors stay English (scripts/anchors.txt)."
    },
    "base_branch": {
      "type": "string"
    },
    "protected_branches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_rework": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_questions_round": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_dev": {
          "type": "integer",
          "minimum": 1
        },
        "headcount": {
          "type": "object",
          "description": "Agents of one role that may run at the same time, team-wide (default 1; dev defaults to max_parallel_dev, reviewer to dev). Read by team.py wave.",
          "properties": {
            "tech-lead": {
              "type": "integer",
              "minimum": 1
            },
            "analyst": {
              "type": "integer",
              "minimum": 1
            },
            "researcher": {
              "type": "integer",
              "minimum": 1
            },
            "architect": {
              "type": "integer",
              "minimum": 1
            },
            "designer": {
              "type": "integer",
              "minimum": 1
            },
            "dev": {
              "type": "integer",
              "minimum": 1
            },
            "reviewer": {
              "type": "integer",
              "minimum": 1
            },
            "qa": {
              "type": "integer",
              "minimum": 1
            },
            "writer": {
              "type": "integer",
              "minimum": 1
            },
            "maintainer": {
              "type": "integer",
              "minimum": 1
            },
            "devops": {
              "type": "integer",
              "minimum": 1
            },
            "coach": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "max_agents_per_feature": {
          "type": "object",
          "properties": {
            "S": {
              "type": "integer",
              "minimum": 1
            },
            "M": {
              "type": "integer",
              "minimum": 1
            },
            "L": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "S",
            "M",
            "L"
          ]
        },
        "feature_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "context_warn_pct": {
          "type": "integer",
          "minimum": 1
        },
        "max_temp_skills": {
          "type": "integer",
          "minimum": 0,
          "description": "Cap on active temp skills/agents"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_rework",
        "max_attempts",
        "max_questions_round",
        "max_parallel_dev",
        "max_agents_per_feature",
        "feature_budget_usd",
        "context_warn_pct",
        "max_temp_skills"
      ]
    },
    "models": {
      "type": "object",
      "properties": {
        "team-leader": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "tech-lead": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "coach": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "analyst": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "researcher": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "architect": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "designer": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "dev": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "reviewer": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "qa": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "writer": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "maintainer": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        },
        "devops": {
          "type": "string",
          "description": "sonnet|opus|haiku|fable|inherit or a model ID"
        }
      },
      "additionalProperties": false
    },
    "approvers": {
      "type": "object",
      "properties": {
        "G0_takeover": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G1_spec": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G2_arch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G2b_design": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G3_plan": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G4_uat": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        },
        "G5_prod": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may approve this gate"
        }
      },
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "max_lines_per_entry": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "handoff_max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "explore_cache_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "research_cache_ttl_by_version": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "string",
          "description": "Where questions go when there is no dialog (default issue-comment)"
        },
        "notify": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
