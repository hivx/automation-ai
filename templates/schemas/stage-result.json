{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automation-ai/schemas/stage-result.json",
  "title": "team stage result (handoff of ≤ 10 lines as JSON when running headless)",
  "type": "object",
  "required": ["feature", "stage", "agent", "verdict", "next"],
  "properties": {
    "feature": {"type": "string", "description": "Feature ID, e.g. FEAT-001"},
    "stage": {"type": "string", "enum": ["takeover", "onboard", "intake", "analyze", "research", "architect", "design", "plan", "build", "verify", "asbuilt", "pr", "release", "clean", "ci", "retro", "audit"]},
    "agent": {"type": "string", "description": "Role that did the work, e.g. team:qa"},
    "artifact": {"type": ["string", "null"], "description": "Path of the main artifact"},
    "verdict": {"type": "string", "enum": ["done", "SPECIFIED", "NEEDS_ANSWER", "WAITING_FOR_ANSWER", "WAITING_FOR_APPROVAL", "BLOCKED", "DESIGN_CONFLICT", "approve", "request-changes", "design-defect", "accepted", "rework"]},
    "evidence_ref": {"type": ["string", "null"], "description": "Where the real command output is (file:line or log)"},
    "missing": {"type": "array", "items": {"type": "string"}},
    "next": {"type": "string", "description": "Next command for the human or the calling role"}
  },
  "additionalProperties": false
}
