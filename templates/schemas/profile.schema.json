{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automation-ai/schemas/profile.schema.json",
  "title": "team profile (.team/profile.json)",
  "type": "object",
  "required": [
    "stack",
    "cmd",
    "structure",
    "protected_paths"
  ],
  "properties": {
    "stack": {
      "type": "string",
      "description": "Main stack name"
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Languages used in the repo"
    },
    "cmd": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string",
          "description": "Install dependencies"
        },
        "build": {
          "type": "string",
          "description": "Build"
        },
        "test": {
          "type": "string",
          "description": "Full test suite"
        },
        "test_one": {
          "type": "string",
          "description": "Tests of one file; uses the {file} placeholder; must contain {file} (the only placeholder) or be empty",
          "pattern": "^$|\\{file\\}"
        },
        "lint": {
          "type": "string",
          "description": "Lint"
        },
        "typecheck": {
          "type": "string",
          "description": "Type check"
        },
        "format": {
          "type": "string",
          "description": "Format one file; uses the {file} placeholder; must contain {file} (the only placeholder) or be empty",
          "pattern": "^$|\\{file\\}"
        },
        "run": {
          "type": "string",
          "description": "Run the application"
        },
        "migrate": {
          "type": "string",
          "description": "Run migrations"
        }
      },
      "additionalProperties": false,
      "required": [
        "test_one"
      ],
      "description": "Commands run from the repo root; {file} is the only placeholder"
    },
    "formatters_by_ext": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "\\{file\\}"
      },
      "description": "File extension → format command containing {file}"
    },
    "structure": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "Source folder"
        },
        "tests": {
          "type": "string",
          "description": "Test folder or 'colocated'"
        },
        "docs": {
          "type": "string",
          "description": "Docs folder"
        },
        "scripts": {
          "type": "string",
          "description": "Scripts folder"
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Config files/folders"
        },
        "allowed_new_file_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CLOSED list of places where new files may be created"
        }
      },
      "additionalProperties": false,
      "required": [
        "allowed_new_file_roots"
      ]
    },
    "naming": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "constant": {
          "type": "string"
        },
        "test_file": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "skip_markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test-skip markers that must not be used to get green"
        },
        "shared_state": {
          "type": "boolean",
          "description": "true when test runs share one database, site or service and two full suites at once interfere (deadlocks, leaked rows); the build then runs the full cmd.test only after each serial merge, never inside a parallel wave"
        }
      },
      "additionalProperties": false
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Globs no agent may edit: secrets, lockfiles, vendored code, prod config"
    },
    "ci": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "none"
          ]
        },
        "runner": {
          "type": "string"
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command that prepares the CI environment"
        }
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "properties": {
        "staging": {
          "type": "string",
          "description": "Staging deploy command"
        },
        "smoke": {
          "type": "string",
          "description": "Smoke test command"
        },
        "prod_requires_reviewer": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "Prod always needs a human approver"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "boolean",
      "description": "The project has a user interface"
    },
    "tracker": {
      "type": "string",
      "enum": [
        "github",
        "gitlab",
        "none"
      ]
    },
    "plugins": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "name@marketplace"
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "name@marketplace"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Slot → one-line note (uncertain value, reason)"
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "Monorepo: folder → partial profile override"
    }
  },
  "additionalProperties": false
}
