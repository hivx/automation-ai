{
  "agent": "team:team-leader",
  "enabledPlugins": {
    "team@automation-ai": true
  },
  "permissions": {
    "allow": [
      "{{cmd.*}}",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(touch .team/active-build-*)",
      "Bash(rm .team/active-build-*)",
      "Bash(rm -f .team/active-build-*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(jq *)",
      "Bash(python3 *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf *)",
      "Edit({{protected_paths}})",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "skillOverrides": {}
}
